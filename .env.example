# Backend settings (all optional; Electron sets the token, port and data dir itself in normal use).
# NEVER put API keys here. Enter them in FRIDAY > Settings; they go to the Windows Credential Manager.
FRIDAY_OLLAMA_URL=http://127.0.0.1:11434
FRIDAY_ANTHROPIC_BASE_URL=https://api.anthropic.com
FRIDAY_REQUEST_TIMEOUT=120
# Only for running the backend by hand:
# FRIDAY_TOKEN=some-long-random-string
# FRIDAY_PORT=8765
# FRIDAY_DATA_DIR=C:\Users\you\AppData\Roaming\FRIDAY\data
